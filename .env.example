# Copy this file to `.env` and adjust as needed, then restart `npx expo start`.
#
# The HRMS backend runs as separate services. The mobile app talks to two of
# them directly:
#   - auth-service        (default port 8081) — login / current user
#   - orchestrator-agent  (default port 8080) — the Shrija AI chat endpoint
#
# --- Choosing EXPO_PUBLIC_API_HOST ---
# iOS Simulator / web preview  -> localhost                (default, no .env needed)
# Android emulator             -> 10.0.2.2                 (used automatically, no .env needed)
# Physical phone (Expo Go/dev build) -> your computer's LAN IP, e.g. 192.168.1.50
#   (find it with `ipconfig` on Windows or `ifconfig`/`ip addr` on macOS/Linux;
#    phone and computer must be on the same Wi-Fi network, and the backend
#    must be started with 0.0.0.0 binding / no firewall blocking these ports)

# EXPO_PUBLIC_API_HOST=192.168.1.50
# EXPO_PUBLIC_AUTH_SERVICE_PORT=8081
# EXPO_PUBLIC_ORCHESTRATOR_PORT=8080

# Alternatively, set full URLs directly (e.g. for a deployed backend, or if
# the two services live on different hosts/schemes). These take priority
# over the host/port variables above.
# EXPO_PUBLIC_AUTH_SERVICE_URL=https://api.example.com/auth
# EXPO_PUBLIC_ORCHESTRATOR_URL=https://api.example.com/orchestrator
